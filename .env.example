# ==========================================
# OXYS Environment Configuration
# ==========================================

# Server Host and Port
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Real External Data Source Configuration (Public / Zero-Auth or API-Key Enabled)
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_POLL_INTERVAL_SECONDS=60
DATA_SOURCE_URL=https://api.binance.com/api/v3/ticker/24hr
DATA_SOURCE_API_KEY=
WEATHER_DATA_SOURCE_URL=https://api.open-meteo.com/v1/forecast

# Kafka Streaming Infrastructure
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=oxys.raw
KAFKA_NORMALIZED_TOPIC=oxys.normalized
KAFKA_QUARANTINE_TOPIC=oxys.quarantine
KAFKA_CONSUMER_GROUP=oxys-spark-cg

# Real Database (PostgreSQL / SQLite fallback)
# PostgreSQL connection string: postgresql://postgres:postgres@localhost:5432/oxys
DATABASE_URL=sqlite:///./oxys.db

# MinIO / S3 Object Storage (Quarantine Vault & Checkpoints)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_QUARANTINE_BUCKET=oxys-quarantine
MINIO_CHECKPOINT_BUCKET=oxys-checkpoints
MINIO_LAKEHOUSE_BUCKET=oxys-lakehouse

# OXYS Kinetic Circuit Breaker & Guard Thresholds
NULL_RATE_THRESHOLD=15.00
CARDINALITY_MIN_THRESHOLD=0.40
DISTRIBUTION_Z_THRESHOLD=3.50
CIRCUIT_AUTO_RESET_SEC=60
