{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(health|metrics|events|anomalies|schema|quarantine|pipeline/.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/metrics",
      "destination": "/api/index.py"
    },
    {
      "source": "/events",
      "destination": "/api/index.py"
    },
    {
      "source": "/anomalies",
      "destination": "/api/index.py"
    },
    {
      "source": "/schema",
      "destination": "/api/index.py"
    },
    {
      "source": "/quarantine",
      "destination": "/api/index.py"
    },
    {
      "source": "/pipeline/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    }
  ]
}
